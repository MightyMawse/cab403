{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Controller",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/con",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Call",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/call",
            "args": [
                "car",
                "1",
                "up"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "description": "Enable pretty-printing for gdb",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}